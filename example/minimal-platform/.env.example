# Remote digital-human Gateway, normally the single public BFF base URL.
AVATAR_API_BASE_URL=https://digital-human.example.com:8006

# Stored only on this platform server. Never expose it to browser JavaScript.
AVATAR_API_KEY=

# Required when the Gateway uses an internal/self-signed certificate.
# The platform server trusts this CA; users do not install it in their browser.
AVATAR_CA_BUNDLE=/opt/platform/certs/digital-human-ca.pem

# Server-side owner identity for private user-created avatars.
PLATFORM_AVATAR_OWNER_ID=platform-demo

# Platform service binding.
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8080

# Browser microphone access requires HTTPS. Prefer TLS termination at the
# platform reverse proxy. These values are for direct Uvicorn TLS if needed.
PLATFORM_TLS_CERT=
PLATFORM_TLS_KEY=

# Optional browser origins when the page is not served by this BFF.
PLATFORM_ALLOWED_ORIGINS=

UPSTREAM_TIMEOUT_SECONDS=60
MAX_REQUEST_BODY_BYTES=65536
WEBSOCKET_MAX_MESSAGE_BYTES=16777216
CUSTOMIZATION_MAX_UPLOAD_BYTES=241172480
